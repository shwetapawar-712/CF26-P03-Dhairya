# NLC Environment Configuration

# Optional: Google Gemini API key for structured policy parsing
# If empty, NLC automatically uses the built-in deterministic parser
GEMINI_API_KEY=

# Database Connection (SQLite default for zero-config dev, swap to postgresql+asyncpg:// for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/nlc.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
